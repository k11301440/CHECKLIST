<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_focus_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@android:color/black">

    <!-- Header: Phase Name & Time Left -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_focus_phase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PHASE 01 朝"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/widget_focus_time_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45m left"
            android:textColor="#888888"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:id="@+id/widget_focus_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:background="#333333" />

    <!-- Center Content: Focus Task (Most important / Top task) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_focus_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRIORITY TARGET"
            android:textColor="#888888"
            android:textSize="9sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_focus_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No pending critical tasks"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/widget_focus_subinfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remaining: 2 Critical • 3 Standard"
            android:textColor="#666666"
            android:textSize="10sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>
