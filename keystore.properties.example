# ==============================================================================
# Keystore Configuration Template
# ==============================================================================
# このファイルを 'keystore.properties' にコピーして実際の値を設定してください。
# 'keystore.properties' は .gitignore に登録されており、Git にコミットされません。
# ==============================================================================
storeFile=checklist-release-key.jks
storePassword=your_keystore_password
keyAlias=checklist-release-key
keyPassword=your_key_password
